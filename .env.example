# Copie ce fichier vers .env puis renseigne au moins UNE clé.
# (ne jamais committer .env — il est ignoré par .gitignore)
# Un provider n'est activé que si sa clé est présente. L'ordre d'essai suit
# l'ordre ci-dessous (rotation / repli automatique).

# --- 1) OpenRouter (accès à de nombreux modèles via une seule clé) ----------
OPENROUTER_API_KEY=
# Un ou plusieurs modèles, séparés par des virgules (essayés dans l'ordre) :
OPENROUTER_MODELS=mistralai/mistral-large,xiaomi/mimo-v2.5
# (compat. ascendante : OPENROUTER_XIAOMI_MODEL / OPENROUTER_MISTRAL_MODEL)

# --- 2) Google Gemini -------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- 3) Tout endpoint compatible OpenAI -------------------------------------
# Pour un modèle LOCAL (Ollama, LM Studio, vLLM) ou une passerelle (Groq,
# Together, DeepInfra…). Renseigne la base_url ; la clé peut être vide en local.
#   Exemples de base_url :
#     Ollama     : http://localhost:11434/v1
#     LM Studio  : http://localhost:1234/v1
#     Groq       : https://api.groq.com/openai/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini

# --- Divers -----------------------------------------------------------------
# ENABLE_REVIEW=0   # désactive la Couche 4 (auto-analyse/auto-complétion)
